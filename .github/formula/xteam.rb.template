require "open3"

class Xteam < Formula
  desc "Three-pane project orchestrator: pm / tl / dev"
  homepage "https://github.com/ffqa/xpier-xteam"
  url "https://github.com/ffqa/xpier-xteam/releases/download/xteam-v@VERSION@/@NAME@.tar.gz"
  sha256 "@SHA256@"
  license "MIT"
  version "@VERSION@"

  # **刻意不 depends_on 任何 Python。**
  #
  # 原来是 depends_on "python@3.12"，而它会连带 mpdecimal / openssl@3 /
  # readline / sqlite / xz / ca-certificates —— 为一个 200K 的纯文本工具装一整套
  # 带 openssl 的 Python，而且还要顺带**升级**用户已有的 openssl@3、readline、
  # pkgconf、ca-certificates。对「装个终端协作器」来说这个代价不成比例。
  #
  # 代价是真的要说清楚：Homebrew 不保证 PATH 里有 python3。macOS 从 12.3 起
  # 移除了 /usr/bin/python3（它来自 Command Line Tools）；没装 CLT 的机器上
  # `brew install xteam` 会装成功、但第一次运行时 xteam 找不到 python3。
  # 所以 install 里**必须自己体检并给出可执行的修复指令** —— 不能靠 brew
  # 帮我们保证。
  #
  # 为什么不干脆 depends_on "python"：那还是同一套 openssl 依赖树，只是版本号
  # 变了好看；而且会把用户已有的 python3 一起升级。
  #
  # 为什么不用 python@3.9：Homebrew 已停止维护 3.9，且 CLT 自带的正是它。

  def install
    # python3 判定只有一个来源 = install.sh 的 preflight()（它会找 brew 版本化
    # Python 的 opt/*/libexec/bin，比公式侧自查更准）。公式侧不再自己实现判定，
    # 也不许用依赖 shell 语义的单字符串调用 —— Formula#system 对单字符串走
    # Kernel.exec 不经 shell，同一行在 `brew ruby` 里成立、在 install 里却 false
    # （0.2.1 实测踩中：/usr/bin/python3 明明在，却走了「找不到」分支）。
    # 体检以 argv 形式委托 install.sh --check，失败输出带进 odie。
    check_out, check_st = Open3.capture2e(
      "bash", "install.sh", "--check", "--prefix", prefix)
    unless check_st.success?
      odie <<~EOS
        安装前体检没过（install.sh --check 失败）：
        #{check_out}
        · 想用 Homebrew 的版本：brew install python@3.12
        · 装完重跑：brew install #{full_name}
      EOS
    end
    system "bash", "install.sh", "--prefix", prefix
  end

  def caveats
    <<~EOS
      xteam 自己不依赖 herdr，但它要**编排** herdr 管的 agent（pm/tl/dev 三个
      pane 都由 herdr 拉起）。没装 herdr 时 xteam 能 init/say/status/note，
      但 up 会失败。

      运行需要 PATH 上有一个 ≥ 3.9 的 python3。macOS 自带的 /usr/bin/python3
      来自 Command Line Tools；如果 brew install 时提示找不到，用
      `xcode-select --install` 装 CLT，或 `brew install python@3.12`。

      安装：见 https://herdr.dev
    EOS
  end

  # Homebrew 的 DSL 是 `test do ... end`（方法 + block），**不是** `def test do` ——
  # 后者是语法错误，而它只会在用户 brew install 时才炸。
  test do
    assert_match "xteam", shell_output("#{bin}/xteam --version")
    assert_match "usage", shell_output("#{bin}/xteam --help")
  end
end
