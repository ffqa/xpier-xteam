class Xteam < Formula
  desc "Three-pane project orchestrator: pm / tl / dev"
  homepage "https://github.com/ffqa/xpier-xteam"
  url "https://github.com/ffqa/xpier-xteam/releases/download/xteam-v@VERSION@/@NAME@.tar.gz"
  sha256 "@SHA256@"
  license "MIT"
  version "@VERSION@"

  depends_on "python@3.12"

  def install
    # Homebrew 的**版本化** Python 不把 opt/python@3.12/libexec/bin 放进 PATH
    # （brew 刻意不 link，只在 `brew info` 里可见），而 install.sh 找的是
    # python3 —— 不显式补 PATH，brew install 会以「找不到 python3」失败。
    ENV.prepend_path "opt/python@3.12/libexec/bin"
    system "bash", "install.sh", "--prefix", prefix
  end

  def caveats
    <<~EOS
      xteam 自己不依赖 herdr，但它要**编排** herdr 管的 agent（pm/tl/dev 三个
      pane 都由 herdr 拉起）。没装 herdr 时 xteam 能 init/say/status/note，
      但 up 会失败。

      安装：见 https://herdr.dev
    EOS
  end

  test do
    # 同样要能找到版本化的 python3
    ENV.prepend_path "opt/python@3.12/libexec/bin"
    assert_match "xteam", shell_output("#{bin}/xteam --version")
    assert_match "usage", shell_output("#{bin}/xteam --help")
  end
end
